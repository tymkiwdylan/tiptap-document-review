{
  "name": "tiptap-document-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rich-text document review for Tiptap and ProseMirror, with grouped decisions and an interactive browser demo.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup src/index.ts --dts --format esm --sourcemap --out-dir dist --clean",
    "smoke": "node scripts/smoke-built.mjs",
    "dev": "vite demo --host 127.0.0.1 --port 5173",
    "build:demo": "tsc -p demo/tsconfig.json --noEmit && node scripts/build-demo.mjs",
    "preview:demo": "vite preview --outDir demo-dist --host 127.0.0.1 --port 5173",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@dmsnell/diff-match-patch": "^1.1.0",
    "@tiptap/core": "^3.10.1",
    "@tiptap/extension-image": "^3.10.1",
    "@tiptap/extension-link": "^3.10.1",
    "@tiptap/extension-table": "^3.10.1",
    "@tiptap/extension-table-cell": "^3.10.1",
    "@tiptap/extension-table-header": "^3.10.1",
    "@tiptap/extension-table-row": "^3.10.1",
    "@tiptap/extension-text-align": "^3.10.1",
    "@tiptap/extension-text-style": "^3.10.1",
    "@tiptap/extension-underline": "^3.10.1",
    "@tiptap/pm": "^3.10.1",
    "@tiptap/starter-kit": "^3.10.1",
    "jsondiffpatch": "^0.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild": "0.27.7",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tymkiwdylan/tiptap-document-review.git"
  },
  "homepage": "https://tymkiwdylan.github.io/tiptap-document-review/",
  "keywords": [
    "tiptap",
    "prosemirror",
    "typescript",
    "document-review",
    "tracked-changes"
  ]
}
